# EXEMPLO DE REFATORAÇÃO DO Game.gd
# Este arquivo mostra como integrar os managers no Game.gd
# NÃO é um arquivo funcional, apenas um exemplo de estrutura

extends Node2D

# Pré-carregar classes
const GridManager = preload("res://scripts/GridManager.gd")
const Pathfinder = preload("res://scripts/Pathfinder.gd")
const WaveManager = preload("res://scripts/WaveManager.gd")
const ProjectileManager = preload("res://scripts/ProjectileManager.gd")
const GameConstants = preload("res://scripts/Constants.gd")

# Managers principais
const EnemyManager = preload("res://scripts/managers/EnemyManager.gd")
const ResourceManager = preload("res://scripts/managers/ResourceManager.gd")
const EffectsManager = preload("res://scripts/managers/EffectsManager.gd")
const PlacementManager = preload("res://scripts/managers/PlacementManager.gd")
const CombatManager = preload("res://scripts/managers/CombatManager.gd")
const CoinManager = preload("res://scripts/managers/CoinManager.gd")
const TowerManager = preload("res://scripts/managers/TowerManager.gd")
const StructureManager = preload("res://scripts/managers/StructureManager.gd")
const UIManager = preload("res://scripts/managers/UIManager.gd")

# Instâncias dos managers
var grid_manager: GridManager
var pathfinder: Pathfinder
var wave_manager: WaveManager
var projectile_manager: ProjectileManager

var enemy_manager: EnemyManager
var resource_manager: ResourceManager
var effects_manager: EffectsManager
var placement_manager: PlacementManager
var combat_manager: CombatManager
var coin_manager: CoinManager
var tower_manager: TowerManager
var structure_manager: StructureManager
var ui_manager: UIManager

# Estado do jogo
var base_hp: int = 100
var paused: bool = false
var game_over: bool = false
var hero: Dictionary = {}

# Projéteis (será migrado para ProjectileManager)
var arrows: Array = []
var tower_bullets: Array = []
var aoe_cannon_projectiles: Array = []

func _ready() -> void:
	# Inicializar managers principais
	grid_manager = GridManager.new()
	pathfinder = Pathfinder.new(grid_manager.grid, grid_manager.center)
	wave_manager = WaveManager.new()
	projectile_manager = ProjectileManager.new()
	
	# Inicializar managers especializados
	enemy_manager = EnemyManager.new(grid_manager, pathfinder, wave_manager)
	resource_manager = ResourceManager.new()
	effects_manager = EffectsManager.new()
	placement_manager = PlacementManager.new(grid_manager, pathfinder)
	coin_manager = CoinManager.new(effects_manager)
	tower_manager = TowerManager.new()
	structure_manager = StructureManager.new()
	
	# Conectar sinais
	enemy_manager.enemy_reached_base.connect(_on_enemy_reached_base)
	enemy_manager.game_over_reached.connect(_on_game_over)
	coin_manager.coin_collected.connect(_on_coin_collected)
	tower_manager.tower_fired.connect(_on_tower_fired)
	structure_manager.mine_triggered.connect(_on_mine_triggered)
	
	# Configurar UI
	var canvas_layer = $CanvasLayer
	ui_manager = UIManager.new(canvas_layer)
	ui_manager.buy_item_requested.connect(_on_buy_item_requested)
	ui_manager.upgrade_selected.connect(_on_upgrade_selected)
	ui_manager.resume_after_upgrade.connect(_on_resume_after_upgrade)
	
	# Carregar recursos
	resource_manager.loading_progress_updated.connect(_on_loading_progress)
	resource_manager.load_all_textures()
	
	# Configurar hero
	hero = {
		"x": 0.0,
		"y": 0.0,
		"cooldown": 0.0,
		"fire_rate": GameConstants.HERO_BASE_FIRE_RATE,
		"damage": GameConstants.HERO_BASE_DAMAGE,
		"pierce": 0,
		"range": 9999.0,
		"levels": {"DMG": 0, "FIRERATE": 0, "PIERCE": 0},
		"coins": GameConstants.HERO_START_COINS
	}
	
	# Configurar combat manager
	combat_manager = CombatManager.new(
		enemy_manager.enemies,
		enemy_manager,
		hero
	)
	combat_manager.enemy_killed.connect(_on_enemy_killed)
	
	set_process(true)
	set_physics_process(true)

func _process(delta: float) -> void:
	if paused or game_over:
		return
	
	# Atualizar inimigos usando EnemyManager
	for enemy in enemy_manager.enemies:
		enemy_manager.update_enemy(enemy, delta)
	
	# Atualizar efeitos usando EffectsManager
	effects_manager.update_effects(delta)
	
	# Atualizar moedas usando CoinManager
	coin_manager.update_coins(delta)
	
	# Atualizar torres usando TowerManager
	tower_manager.update_towers(
		delta,
		enemy_manager.enemies,
		tower_manager.get_boost_towers()
	)
	
	# Atualizar estruturas usando StructureManager
	var base_center = grid_manager.tile_center(
		grid_manager.center.x,
		grid_manager.center.y
	)
	structure_manager.update_structures(
		delta,
		enemy_manager.enemies,
		grid_manager,
		pathfinder
	)
	
	# Atualizar combate usando CombatManager
	arrows = combat_manager.check_projectile_collisions(arrows, "arrow")
	tower_bullets = combat_manager.check_projectile_collisions(tower_bullets, "tower")
	
	# Remover inimigos mortos
	enemy_manager.remove_dead_enemies()
	
	# Atualizar UI usando UIManager
	ui_manager.update_top_bar(
		wave_manager.wave,
		enemy_manager.enemies.size(),
		hero["coins"],
		base_hp,
		wave_manager.is_boss_wave()
	)
	
	queue_redraw()

func _on_enemy_reached_base(damage: int, is_boss: bool) -> void:
	base_hp = max(0, base_hp - damage)
	if base_hp <= 0 and not game_over:
		game_over = true
		paused = true
		ui_manager.show_game_over(wave_manager.wave)

func _on_enemy_killed(enemy_pos: Vector2, is_boss: bool) -> void:
	var reward = GameConstants.BOSS_REWARD_MULTIPLIER * GameConstants.NORMAL_REWARD if is_boss else GameConstants.NORMAL_REWARD
	hero["coins"] += reward
	coin_manager.try_drop_coin(enemy_pos)

func _on_coin_collected(value: int) -> void:
	hero["coins"] += value

func _on_tower_fired(tower_data: Dictionary, projectile: Dictionary) -> void:
	match tower_data.get("type", ""):
		"tower":
			tower_bullets.append(projectile)
		"aoe_cannon":
			aoe_cannon_projectiles.append(projectile)
		"sniper":
			effects_manager.create_sniper_effect(projectile.start, projectile.end)
			combat_manager.check_sniper_line_damage(
				projectile.start,
				projectile.end,
				projectile.damage,
				projectile.pierce
			)

func _on_buy_item_requested(item_type: String) -> void:
	placement_manager.start_placing(item_type)

func _on_upgrade_selected(option_index: int) -> void:
	# Lógica de upgrade
	pass

func _on_resume_after_upgrade() -> void:
	ui_manager.hide_upgrade_overlay()
	wave_manager.start_next_wave()

func _on_loading_progress(progress: float) -> void:
	ui_manager.update_loading_progress(progress)
	if progress >= 1.0:
		await get_tree().create_timer(0.3).timeout
		ui_manager.hide_loading_screen()

# ... resto da lógica de desenho e input ...


